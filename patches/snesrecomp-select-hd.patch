diff --git a/runner/src/desktop/graphics_select_tap.h b/runner/src/desktop/graphics_select_tap.h
new file mode 100644
--- /dev/null
+++ b/runner/src/desktop/graphics_select_tap.h
@@ -0,0 +1,22 @@
+#pragma once
+#include <stdbool.h>
+
+/* A tap fires once on release. Select combinations belong to modal menus. */
+typedef struct GraphicsSelectTap {
+  bool held, chord;
+} GraphicsSelectTap;
+
+static inline bool GraphicsSelectTap_Update(GraphicsSelectTap *tap,
+    bool held, bool other_button, bool blocked) {
+  if (held && !tap->held) {
+    tap->held = true;
+    tap->chord = other_button || blocked;
+  }
+  if (tap->held && (other_button || blocked)) tap->chord = true;
+  if (!held && tap->held) {
+    bool fire = !tap->chord;
+    tap->held = tap->chord = false;
+    return fire;
+  }
+  return false;
+}
