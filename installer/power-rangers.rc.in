#include <windows.h>
1 ICON "@CMAKE_SOURCE_DIR@/installer/assets/power-rangers.ico"
1 VERSIONINFO
 FILEVERSION @POWER_RANGERS_RESOURCE_VERSION@,0
 PRODUCTVERSION @POWER_RANGERS_RESOURCE_VERSION@,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "Mighty Morphin Power Rangers The Movie PC Recomp\0"
   VALUE "FileVersion", "@GAME_RELEASE_VERSION@\0"
   VALUE "ProductName", "Mighty Morphin Power Rangers The Movie PC Recomp\0"
   VALUE "ProductVersion", "@GAME_RELEASE_VERSION@\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
